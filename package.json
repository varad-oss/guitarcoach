{
  "name": "guitarcoach",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-assets.mjs",
    "prebuild": "node scripts/copy-assets.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "LIVE_IMPORT=1 vitest run src/lib/import/live.test.ts",
    "test:e2e": "playwright test",
    "eval:guitarset": "GUITARSET=1 vitest run src/lib/dsp/guitarset.eval.test.ts",
    "test:all": "npm run typecheck && npm run lint && npm run test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "@tesseract.js-data/eng": "^1.0.0",
    "idb": "^8.0.4",
    "next": "16.4.0",
    "pdfjs-dist": "^6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tesseract.js": "^7.0.0",
    "undici": "^8.12.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.4"
  }
}
